# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional-for-admin

# Resend Email Configuration
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=EliteHub Properties Customer Care <care@elitehubproperties.com>
CARE_NOTIFICATION_EMAIL=care@elitehubproperties.com
# Cron Job Secret (for /api/cron/sla-check)
CRON_SECRET=your-secure-cron-bearer-token

# Environment
NODE_ENV=production
